# ─────────────────────────────────────────────────────────────
# Remember — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env.local. NEVER expose server-only vars to the client.
# ─────────────────────────────────────────────────────────────

# ── PUBLIC (safe to expose to the browser) ──
# These are read by client components. They are anon/public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── SERVER ONLY (never expose, never prefix with NEXT_PUBLIC_) ──
# Full-access key. server only, never expose. Used only in server code
# (route handlers / server actions) for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── FEATURE FLAGS ──
# AI is an isolated abstraction layer and is disabled by default in the MVP.
# Allowed values: disabled | openai | anthropic | local (only "disabled" is wired up in Phase 0).
AI_PROVIDER=disabled
