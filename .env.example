# ─────────────────────────────────────────────────────────────
# Remember — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env.local. NEVER expose server-only vars to the client.
# ─────────────────────────────────────────────────────────────

# ── PUBLIC (safe to expose to the browser) ──
# Supabase Project URL (API Gateway endpoint)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (replaces legacy NEXT_PUBLIC_SUPABASE_ANON_KEY; both supported)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── SERVER ONLY (never expose, never prefix with NEXT_PUBLIC_) ──
# Supabase Secret Key (replaces legacy SUPABASE_SERVICE_ROLE_KEY; both supported)
# Used only in server code and administrative maintenance scripts.
SUPABASE_SECRET_KEY=your-secret-key

# ── AI & SEARCH (Phase 2) ──
# Master switch for AI: disabled | openrouter
AI_PROVIDER=disabled

# Required only if AI_PROVIDER=openrouter:
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional OpenRouter overrides (defaults shown):
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_SITE_URL=https://your-domain.com

